# Required. Apify API token, from https://console.apify.com/settings/integrations
APIFY_TOKEN=

# Only needed for `--sink pinecone` in rag_refresh.py
PINECONE_API_KEY=
PINECONE_INDEX=
OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small

# Only needed for the `browsing` arm in benchmark/. A paid Anthropic API key, which
# is not the same thing as a Claude subscription. https://console.anthropic.com/
ANTHROPIC_API_KEY=
